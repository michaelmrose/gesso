{:paths ["src" "resources"]

 :tasks
 {:init
  ;; Selection and execution strategy are independent. The ordinary command
  ;; keeps its existing direct Gesso runner; -n N delegates just the selected
  ;; scope to Shard's exactly-once-preflight supervisor.
  (defn dispatch-gesso-test! [scope command-line]
    (let [args (vec command-line)]
      (cond
        (empty? args)
        (shell "bb" "script/gesso_test.clj" scope)

        (and (= 2 (count args)) (= "-n" (first args)))
        (let [workers (try
                        (Long/parseLong (second args))
                        (catch NumberFormatException _ nil))]
          (when-not (and workers (<= 1 workers 256))
            (throw (ex-info "Worker count must be an integer from 1 to 256."
                            {:scope scope :arguments args})))
          ;; Preserve the original no-scope full-suite invocation as well as
          ;; its Gesso/Shard adapter tests. v1089 defaults this to scope all.
          (if (= "all" scope)
            (shell "shard" "run" "--workers" (str workers))
            (shell "shard" "run" "--workers" (str workers)
                   "--scope" scope)))

        :else
        (throw (ex-info "Usage: bb test[:GATE] [-n N]"
                        {:scope scope :arguments args})))))

  clean
  {:doc "Safely clean current Ygg worker clones; preserve run history and source snapshots."
   :task (shell "ygg" "clean")}

  runtime
  {:doc "Generate the composed Gesso Live browser runtime."
   :task
   (shell "clojure"
          "-M:dev"
          "-m" "cljs.main"
          "-O" "advanced"
          "-co" "{:output-dir \"target/gesso-live-cljs\"}"
          "-o" "resources/public/js/gesso-live.js"
          "-c" "gesso.live.browser.runtime")}

  themes
  {:doc "Build theme CSS."
   :task
   (do
     (println "running themes task")
     ((requiring-resolve 'gesso.build.themes/build!)
      {:input-dir "resources/themes"
       :output-file "resources/public/gesso/themes.css"})
     (println "done"))}

  test
  {:doc "Run the full suite sequentially, or use `bb test -n N` for N Shard workers."
   :task
   (dispatch-gesso-test! "all" *command-line-args*)}

  test:quick
  {:doc "Fast deterministic JVM smoke gate: fixed high-value namespaces, one integrity check, one JVM. Does not replace bb test."
   :task
   (let [;; Deliberately fixed and version-controlled. Historical durations may
         ;; inform a future explicit revision, but never change selection at run time.
         namespaces
         ["gesso.choreo.semantics-test"
          "gesso.choreo.type-test"
          "gesso.model.command-test"
          "gesso.model.invariant-check-test"
          "gesso.model.resolved-operation-test"
          "gesso.model.tx-refinement-test"
          "gesso.live.application-preflight.semantic-audit-test"
          "gesso.live.browser.adapter-proof-test"
          "gesso.live.optimistic.resolved-operation-test"]]
     (when (seq *command-line-args*)
       (throw (ex-info "Usage: bb test:quick (no arguments)"
                       {:arguments (vec *command-line-args*)})))
     ;; Do not quietly pass if a selected namespace is renamed or deleted.
     ;; Both .clj and .cljc are valid in the authoritative JVM corpus.
     (doseq [test-ns namespaces]
       (let [relative (.replace (.replace test-ns "." "/") "-" "_")
             paths [(str "test/" relative ".clj")
                    (str "test/" relative ".cljc")]]
         (when-not (some (fn [path] (.isFile (java.io.File. path))) paths)
           (throw (ex-info "Quick gate references a missing JVM test namespace."
                           {:namespace test-ns :checked-paths paths})))))
     (println "== Gesso quick gate ==")
     (println "Fixed JVM namespaces:" (count namespaces))
     (doseq [test-ns namespaces]
       (println " -" test-ns))
     ;; Run integrity once, then use Cognitect's existing multiple -n support.
     ;; One JVM avoids the repeated startup and duplicated fixture overhead of
     ;; nine separate test invocations. Any test failure exits nonzero.
     (shell "bb" "script/gesso_test.clj" "integrity")
     (apply shell
            (into ["clojure" "-M:test:formal"]
                  (mapcat (fn [test-ns] ["-n" test-ns]) namespaces))))}

  test:jvm
  {:doc "Run all JVM tests; use -n N to distribute JVM namespaces with Shard. Included by `bb test`."
   :task
   (dispatch-gesso-test! "jvm" *command-line-args*)}

  test:formal
  {:doc "Run focused Recife/TLC verification tests (optionally with -n N). Also included by `bb test:jvm` and `bb test`."
   :task
   (dispatch-gesso-test! "formal" *command-line-args*)}

  test:cljs
  {:doc "Run all CLJS/browser gates; use -n N for parallel selected gates. Included by `bb test`."
   :task
   (dispatch-gesso-test! "cljs" *command-line-args*)}

  test:node
  {:doc "Run all Node CLJS tests; use -n N for parallel execution. Included by `bb test:cljs`."
   :task
   (dispatch-gesso-test! "node" *command-line-args*)}

  test:node:choreo
  {:doc "Run the portable Choreo CLJS/CLJC corpus under Node. Included by `bb test:node`."
   :task
   (dispatch-gesso-test! "node:choreo" *command-line-args*)}

  test:node:browser
  {:doc "Run host-independent browser semantic tests under Node. Included by `bb test:node`."
   :task
   (dispatch-gesso-test! "node:browser" *command-line-args*)}

  test:browser
  {:doc "Run every CLJS/CLJC test in real headless Chromium. Included by `bb test:cljs`."
   :task
   (dispatch-gesso-test! "browser" *command-line-args*)}

  test:browser:integration
  {:doc "Run production gesso-live.js against real Chromium + HTMX/SSE + deterministic HTTP fixtures. Included by `bb test:cljs`."
   :task
   (dispatch-gesso-test! "browser:integration" *command-line-args*)}

  test:advanced
  {:doc "Verify the composed production browser runtime advanced-compiles. Included by `bb test`."
   :task
   (dispatch-gesso-test! "advanced" *command-line-args*)}

  test:themes
  {:doc "Verify the theme build without overwriting checked-in CSS. Included by `bb test`."
   :task
   (dispatch-gesso-test! "themes" *command-line-args*)}}}
