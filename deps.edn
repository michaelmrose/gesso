{:paths ["src" "resources"]

 ;; Use Maven's canonical HTTPS Central endpoint instead of the tools.deps
 ;; default repo1 endpoint, which returned HTTP 429 in the v2335 CI run.
 ;; Keep the repository id and every pinned artifact unchanged.
 :mvn/repos {"central" {:url "https://repo.maven.apache.org/maven2/"}}

 :deps
 {org.clojure/clojure
  {:mvn/version "1.12.5"}

  com.biffweb/core
  {:mvn/version "2.0.2"}

  com.biffweb/fx
  {:mvn/version "2.0.2"}

  com.biffweb/graph
  {:mvn/version "2.0.2"}

  com.biffweb/xtdb
  {:mvn/version "2.0.0"
   :exclusions [com.biffweb/core
                com.biffweb/fx
                com.biffweb/graph]}

  com.xtdb/xtdb-api
  {:mvn/version "2.2.0-beta1"}

  com.xtdb/xtdb-aws
  {:mvn/version "2.2.0-beta1"}

  com.xtdb/xtdb-core
  {:mvn/version "2.2.0-beta1"}

  metosin/malli
  {:mvn/version "0.20.1"}

  rum/rum
  {:mvn/version "0.12.11"}

  com.cognitect/transit-clj
  {:mvn/version "1.0.333"}

  manifold/manifold
  {:mvn/version "0.5.0"}

  missionary/missionary
  {:mvn/version "b.47"}

  org.msgpack/msgpack-core
  {:mvn/version "0.9.12"}

  com.zaxxer/HikariCP
  {:mvn/version "7.0.2"}}

 :aliases
 {;; Loaded by the JVM test harness, including the ordinary `bb test` gate.
  ;; Recife's transitive p5 externs must not reach cljs.main/Closure builds.
  :formal
  {:extra-deps
   {pfeodrippe/recife
    {:mvn/version "0.22.0"}}}

  ;; Explicit Aleph 0.9.11 qualification only. Do not add Aleph or its
  ;; Netty resolution to ordinary JVM, CLJS, or browser builds. The
  ;; integration/ tests fail if a real Aleph server cannot be started;
  ;; they are not included by the :test alias alone.
  :aleph-integration
  {:extra-paths ["integration" "test"]
   :extra-deps
   {aleph/aleph {:mvn/version "0.9.11"}
    ;; The actual Biff/Live panel uses the same pinned assets as :test.
    org.webjars.npm/htmx.org {:mvn/version "2.0.7"}
    org.webjars.npm/htmx-ext-sse {:mvn/version "2.2.4"}}}

  ;; Opt-in Typed Clojure feasibility checks. Keep the checker, analyzer,
  ;; and runtime dependencies off ordinary Gesso JVM/CLJS classpaths.
  :typed
  {:extra-paths ["test"]

   :extra-deps
   {org.typedclojure/typed.clj.checker
    {:mvn/version "1.4.0"}}}

  ;; Ansatz stays optional while Gesso evaluates source-derived proofs.
  ;; Its kernel/proof dependencies are not part of normal application builds.
  :ansatz
  {:extra-deps
   {org.replikativ/ansatz
    {:mvn/version "0.2.617"}}}

  :dev
  {:extra-deps
   {org.clojure/clojurescript
    {:mvn/version "1.12.145"}}}

  :test
  {:extra-paths ["test"]

   :extra-deps
   {;; Pin the REAL test HTTP adapter, rather than relying on whatever
    ;; transitive Jetty version happens to appear via another provider.
    info.sunng/ring-jetty9-adapter
    {:mvn/version "0.39.2"}

    com.microsoft.playwright/playwright
    {:mvn/version "1.61.0"}

    org.webjars.npm/htmx.org
    {:mvn/version "2.0.7"}

    org.webjars.npm/htmx-ext-sse
    {:mvn/version "2.2.4"}

    org.clojure/test.check
    {:mvn/version "1.1.2"}

    io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1"
     :git/sha "dfb30dd"}}

   :jvm-opts
   ["--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--enable-native-access=ALL-UNNAMED"
    "-Dio.netty.tryReflectionSetAccessible=true"
    "-Dio.netty.noUnsafe=false"]

   :main-opts
   ["-m" "cognitect.test-runner"]}

  ;; Direct browser-gate entry point. :test deliberately has :main-opts
  ;; [-m cognitect.test-runner], so appending another -m to -M:test sends
  ;; those arguments to the TEST RUNNER instead of running the browser gate.
  ;; Keep the standard :test runner intact, while sharing its browser
  ;; dependencies in this main-opts-free alias for explicit -m dispatch.
  :outbox-browser
  {:extra-paths ["test"]

   :extra-deps
   {com.microsoft.playwright/playwright
    {:mvn/version "1.61.0"}

    org.webjars.npm/htmx.org
    {:mvn/version "2.0.7"}

    org.webjars.npm/htmx-ext-sse
    {:mvn/version "2.2.4"}

    org.clojure/test.check
    {:mvn/version "1.1.2"}}

   :jvm-opts
   ["--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--enable-native-access=ALL-UNNAMED"
    "-Dio.netty.tryReflectionSetAccessible=true"
    "-Dio.netty.noUnsafe=false"]}

  :build
  {:deps
   {io.github.clojure/tools.build
    {:mvn/version "0.10.11"}

    slipset/deps-deploy
    {:mvn/version "0.2.2"}}

   :ns-default build}}}
