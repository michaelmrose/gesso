{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure
  {:mvn/version "1.12.5"}

  com.biffweb/core
  {:git/url "https://github.com/jacobobryant/biff"
   :git/sha "b3abe5b13824af2f83f89ec31c63a430417ac457"
   :deps/root "libs/core"}

  com.biffweb/fx
  {:git/url "https://github.com/jacobobryant/biff"
   :git/sha "b3abe5b13824af2f83f89ec31c63a430417ac457"
   :deps/root "libs/fx"
   :exclusions [com.biffweb/core]}

  com.biffweb/graph
  {:git/url "https://github.com/jacobobryant/biff"
   :git/sha "b3abe5b13824af2f83f89ec31c63a430417ac457"
   :deps/root "libs/graph"
   :exclusions [com.biffweb/core
                com.biffweb/fx]}

  com.biffweb/xtdb
  {:git/url "https://github.com/jacobobryant/biff"
   :git/sha "b3abe5b13824af2f83f89ec31c63a430417ac457"
   :deps/root "libs/xtdb"
   :exclusions [com.biffweb/core
                com.biffweb/fx
                com.biffweb/graph]}

  com.xtdb/xtdb-api
  {:mvn/version "2.2.0-beta1"}

  com.xtdb/xtdb-aws
  {:mvn/version "2.2.0-beta1"}

  com.xtdb/xtdb-core
  {:mvn/version "2.2.0-beta1"}

  metosin/malli
  {:mvn/version "0.20.1"}

  rum/rum
  {:mvn/version "0.12.11"}

  com.cognitect/transit-clj
  {:mvn/version "1.0.333"}

  manifold/manifold
  {:mvn/version "0.5.0"}

  missionary/missionary
  {:mvn/version "b.47"}

  org.msgpack/msgpack-core
  {:mvn/version "0.9.12"}

  com.zaxxer/HikariCP
  {:mvn/version "7.0.2"}}

 :aliases
 {:dev
  {:extra-deps
   {org.clojure/clojurescript
    {:mvn/version "1.12.145"}}}

  :test
  {:extra-paths ["test"]

   :extra-deps
   {com.microsoft.playwright/playwright
    {:mvn/version "1.61.0"}

    org.clojure/test.check
    {:mvn/version "1.1.2"}

    io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1"
     :git/sha "dfb30dd"}}

   :jvm-opts
   ["--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--enable-native-access=ALL-UNNAMED"
    "-Dio.netty.tryReflectionSetAccessible=true"
    "-Dio.netty.noUnsafe=false"]

   :main-opts
   ["-m" "cognitect.test-runner"]}

  :build
  {:deps
   {io.github.clojure/tools.build
    {:mvn/version "0.10.11"}

    slipset/deps-deploy
    {:mvn/version "0.2.2"}}

   :ns-default build}}}
